# Variables consumed by docker/docker-compose.yml and docker/docker-compose-pbs.yml.
# docker compose reads this file automatically from the compose file's directory
# (regardless of which -f file you pass), so it's shared by both clusters.
# Every variable below also has an inline default in the compose files, so this
# file just pins the versions the project builds and tests against.
#
# Note: project name is intentionally NOT set here (e.g. COMPOSE_PROJECT_NAME=...).
# Each compose file declares its own fixed `name:` (rocoto-slurm / rocoto-pbs) so
# the two clusters never share a default network; setting COMPOSE_PROJECT_NAME
# here would override both files' `name:` with the same value and undo that.

# Ubuntu base version. Selects which published image variant we pull from the
# dockerslurmcluster/dockerpbscluster registries (must match a published image
# tag). Currently supported values: '26.04' or '24.04'
UBUNTU_VERSION=26.04

# Slurm version. Selects the slurm version suffix for the image tag.
SLURM_VERSION=25.11.5

# Composite image tag produced from the above:
#   ghcr.io/noaa-gsl/dockerslurmcluster/slurm-<role>:ubuntu-${UBUNTU_VERSION}-slurm-${SLURM_VERSION}

# OpenPBS version. Selects the openpbs version suffix for the PBS image tag.
OPENPBS_VERSION=23.06.06

# Composite image tag produced from the above:
#   ghcr.io/noaa-gsl/dockerpbscluster/pbs-<role>:ubuntu-${UBUNTU_VERSION}-openpbs-${OPENPBS_VERSION}

# Prefix for container/hostnames. Each compose file has its own default
# (rocoto-slurm / rocoto-pbs) so the two clusters never collide; override per
# invocation (along with `-p`) to run additional simultaneous instances, e.g.:
#   CLUSTER_NAME=rocoto-slurm2 docker compose -p rocoto-slurm2 -f docker-compose.yml up -d

#
# To switch versions for a single invocation without editing this file:
#   UBUNTU_VERSION=24.04 SLURM_VERSION=25.11.5 docker compose up
